# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL with PostGIS). Production must use the non-superuser
# networkpeer_app role and sslmode=require (or a stronger TLS mode).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/networkpeer
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-separate-super-secret-refresh-key-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=networkpeer-api
JWT_AUDIENCE=networkpeer-mobile

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=3
OTP_VERIFY_RATE_LIMIT_MAX=5
OTP_MAX_VERIFY_ATTEMPTS=5
# Only ever "true" in local dev; must be "false" in production.
OTP_ECHO_IN_RESPONSE=true
# SMS delivery - "console" prints to server logs (dev), "twilio" sends real SMS.
SMS_PROVIDER=console
OTP_SMS_TEMPLATE=Your NetworkPeer OTP is {{code}}. It expires in {{minutes}} minutes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Leave all three credential variables blank when using an instance/task role.
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=networkpeer-media
# Short-lived presigned POST policy. In production startup verifies all block-
# public-access controls, default server-side encryption, and versioning; the
# runtime IAM role therefore needs s3:GetPublicAccessBlock,
# s3:GetBucketEncryption, and s3:GetBucketVersioning. Configure a lifecycle
# rule for abandoned pending evidence uploads.
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=600
MEDIA_MAX_FILE_SIZE_BYTES=26214400

# Payment Gateway (Stripe Connect)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CONNECT_CLIENT_ID=ca_your-connect-client-id

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_BODY_BYTES=1048576

# Worker discovery
WORKER_NEARBY_MAX_RADIUS_KM=100

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
